# CommitmentOS environment configuration — committed template.
# Copy to .env for local use; .env is gitignored and must never be committed.
#
# Rules:
# - Every variable maps 1:1 to a field in backend/src/commitmentos/bootstrap/settings.py
#   (prefix COMMITMENTOS_, extra="forbid" — do not add variables that have no Settings field).
# - No secret VALUES appear here or in .env: the *_SECRET_REF variables hold Secret Manager
#   resource names; the service reads the values at runtime via Application Default
#   Credentials (locally: `gcloud auth application-default login`).
# - [PHASE-0] = filled during the Phase 0 spike (checklist Part I §2) once the project exists.
# - [FROZEN] = comes from a frozen decision; changing it requires a new decision-log entry.

# --- Runtime ---
COMMITMENTOS_ENVIRONMENT=development
COMMITMENTOS_APPLICATION_VERSION=0.1.0
# Local dev server; in cloud this is the Cloud Run service URL.
COMMITMENTOS_SERVICE_BASE_URL=http://localhost:8080

# --- Controlled user (P0 is single-user by design) ---
COMMITMENTOS_CONTROLLED_USER_ID=user_fixture_controlled_001
# [PHASE-0] The dedicated controlled test account — never a personal mailbox.
COMMITMENTOS_CONTROLLED_EMAIL=controlled-account@example.com
# [FROZEN] golden_scenario_rev_1
COMMITMENTOS_CONTROLLED_TIMEZONE=America/Los_Angeles

# --- Google Cloud ---
# [PHASE-0] Project ID and region are recorded in the spike record when created.
COMMITMENTOS_GOOGLE_CLOUD_PROJECT=commitmentos-p0
COMMITMENTOS_GOOGLE_CLOUD_REGION=us-west1
COMMITMENTOS_FIRESTORE_DATABASE_ID=(default)

# --- Queues and messaging (resource names, not secrets) ---
COMMITMENTOS_SOURCE_SYNC_QUEUE=commitmentos-source-sync
COMMITMENTOS_RECONCILIATION_QUEUE=commitmentos-reconciliation
COMMITMENTOS_CALENDAR_ACTIONS_QUEUE=commitmentos-calendar-actions
# [PHASE-0] Full topic resource name for Gmail users.watch notifications.
COMMITMENTOS_GMAIL_PUBSUB_TOPIC=projects/commitmentos-p0/topics/commitmentos-gmail-watch

# --- Internal route trust: expected OIDC audience + service identity per route group ---
# [PHASE-0] In cloud these audiences are the deployed route URLs; localhost values are
# placeholders for local development only. One distinct service account per delivery kind
# (checklist Part I §2, Identities and credentials).
COMMITMENTOS_PUBSUB_OIDC_AUDIENCE=http://localhost:8080/internal/pubsub
COMMITMENTOS_TASKS_OIDC_AUDIENCE=http://localhost:8080/internal/tasks
COMMITMENTOS_SCHEDULER_OIDC_AUDIENCE=http://localhost:8080/internal/scheduler
COMMITMENTOS_PUBSUB_SERVICE_ACCOUNT=commitmentos-pubsub@commitmentos-p0.iam.gserviceaccount.com
COMMITMENTOS_TASKS_SERVICE_ACCOUNT=commitmentos-tasks@commitmentos-p0.iam.gserviceaccount.com
COMMITMENTOS_SCHEDULER_SERVICE_ACCOUNT=commitmentos-scheduler@commitmentos-p0.iam.gserviceaccount.com

# --- Secret Manager references (resource names only — never raw values) ---
# [PHASE-0] Created during the spike; version-pin instead of "latest" before demo freeze.
COMMITMENTOS_OAUTH_CLIENT_SECRET_REF=projects/commitmentos-p0/secrets/commitmentos-oauth-client/versions/latest
COMMITMENTOS_CONTROLLED_REFRESH_TOKEN_SECRET_REF=projects/commitmentos-p0/secrets/commitmentos-controlled-refresh-token/versions/latest
COMMITMENTOS_GEMINI_API_KEY_SECRET_REF=projects/commitmentos-p0/secrets/commitmentos-gemini-api-key/versions/latest
# Required in production and must differ from the controlled-data Gemini ref.
# Store an API key issued by a sandbox-only Gemini quota project here so public
# free-play traffic cannot exhaust the production extraction quota.
COMMITMENTOS_SANDBOX_GEMINI_API_KEY_SECRET_REF=projects/commitmentos-p0/secrets/commitmentos-sandbox-gemini-api-key/versions/latest
COMMITMENTOS_CALENDAR_CHANNEL_SECRET_REF=projects/commitmentos-p0/secrets/commitmentos-calendar-channel-token/versions/latest

# --- OAuth ---
# testing | production — decided by the Phase 0 §3 publishing-mode spike; testing is the fallback.
COMMITMENTOS_OAUTH_PUBLISHING_MODE=testing
# Must exactly match the authorized redirect URI on the OAuth client (same origin as the app).
COMMITMENTOS_OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback

# --- Gemini ---
# [FROZEN] plan §7.1 — pinned model, low thinking for routine extraction.
COMMITMENTOS_GEMINI_MODEL_ID=gemini-3.5-flash
COMMITMENTOS_GEMINI_THINKING_LEVEL=low
# Provider transport timeout plus an application-level deadline. The public
# model edge is intentionally tighter than controlled-data processing.
COMMITMENTOS_GEMINI_REQUEST_TIMEOUT_SECONDS=45
COMMITMENTOS_SANDBOX_GEMINI_REQUEST_TIMEOUT_SECONDS=20

# --- Pinned versions (written into audit events; bump deliberately, never silently) ---
COMMITMENTOS_PROMPT_VERSION=commitment_interpretation_v2
COMMITMENTOS_EXTRACTION_SCHEMA_VERSION=extraction_v2
COMMITMENTOS_TASK_SCHEMA_VERSION=task_v1
COMMITMENTOS_OBSERVATION_SCHEMA_VERSION=observation_v1
COMMITMENTOS_WORKFLOW_VERSION=reconciliation_v1
COMMITMENTOS_PLANNER_VERSION=portfolio_planner_v1
COMMITMENTOS_RISK_VERSION=portfolio-risk-v1
# [FROZEN] checklist §1 Autonomy policy
COMMITMENTOS_POLICY_VERSION=autonomy_policy_v2
# [FROZEN] plan §10.5 derivation namespace "commitmentos:v1"
COMMITMENTOS_CALENDAR_EVENT_ID_ALGORITHM_VERSION=v1

# --- Calendar ---
# Single exact public webhook path (plan §13.5); everything else on the service is authenticated.
COMMITMENTOS_CALENDAR_WEBHOOK_PATH=/webhooks/calendar
COMMITMENTOS_CALENDAR_ID=primary

# --- Demo mode ---
COMMITMENTOS_DEMO_MODE_ENABLED=false
COMMITMENTOS_DEMO_DATA_DIRECTORY=backend/src/commitmentos/demo_data

# --- Synchronization budgets (plan §9.1.1: ≤400 writes, ≤8 MiB per transaction) ---
COMMITMENTOS_MAXIMUM_SYNC_TRANSACTION_WRITES=400
COMMITMENTOS_MAXIMUM_SYNC_TRANSACTION_BYTES=8388608
COMMITMENTOS_MAXIMUM_SYNC_APPLY_ITEMS_PER_CHUNK=100
COMMITMENTOS_CALENDAR_SYNC_PAGE_SIZE=250
COMMITMENTOS_SYNC_PUBLICATION_BARRIER_PROBE_DELAY_SECONDS=0
COMMITMENTOS_MAINTENANCE_SCAN_LIMIT=200
